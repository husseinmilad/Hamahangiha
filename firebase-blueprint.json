{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile with Gmail identity and executive title.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "defaultTitle": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "photoURL", "defaultTitle", "createdAt", "updatedAt"]
    },
    "UserMembership": {
      "title": "UserMembership",
      "description": "Per-user workspace membership index for O(1) workspace listing.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["owner", "executive", "coordinator", "member"] },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "workspaceName", "role", "ownerUid", "joinedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Real-time notification delivered to a team member when a meeting, task, or event is created or updated.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceName": { "type": "string", "maxLength": 100 },
        "itemId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemType": { "type": "string", "enum": ["meeting", "task", "event", "invite", "system"] },
        "title": { "type": "string", "maxLength": 160 },
        "body": { "type": "string", "maxLength": 500 },
        "senderUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderEmail": { "type": "string", "maxLength": 200 },
        "read": { "type": "boolean" },
        "actionStatus": { "type": "string", "enum": ["none", "pending", "confirmed", "declined", "done"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "workspaceId",
        "workspaceName",
        "itemId",
        "itemType",
        "title",
        "body",
        "senderUid",
        "senderName",
        "senderEmail",
        "read",
        "actionStatus",
        "createdAt"
      ]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Collaborative team workspace (e.g. Boss & Office Manager).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "description", "ownerUid", "createdAt", "updatedAt"]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Member entry inside a workspace subcollection.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["owner", "executive", "coordinator", "member"] },
        "inviteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "photoURL", "role", "inviteId", "joinedAt"]
    },
    "WorkspaceItem": {
      "title": "WorkspaceItem",
      "description": "Shared meeting, task, or event inside a workspace with Jalali and Gregorian dates.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["meeting", "task", "event"] },
        "title": { "type": "string", "maxLength": 180 },
        "description": { "type": "string", "maxLength": 2000 },
        "jalaliDate": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}/\\d{2}/\\d{2}$" },
        "gregorianDate": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "startTime": { "type": "string", "maxLength": 5 },
        "endTime": { "type": "string", "maxLength": 5 },
        "location": { "type": "string", "maxLength": 200 },
        "meetingLink": { "type": "string", "maxLength": 400 },
        "priority": { "type": "string", "enum": ["urgent", "high", "normal", "low"] },
        "status": { "type": "string", "enum": ["scheduled", "in_progress", "completed", "cancelled"] },
        "assigneeEmail": { "type": "string", "maxLength": 200 },
        "assigneeName": { "type": "string", "maxLength": 100 },
        "assigneeUid": { "type": "string", "maxLength": 128 },
        "agenda": { "type": "string", "maxLength": 2000 },
        "minutes": { "type": "string", "maxLength": 3000 },
        "checklist": { "type": "array" },
        "confirmedUids": { "type": "array" },
        "declinedUids": { "type": "array" },
        "notifyMembers": { "type": "boolean" },
        "reminderMinutes": { "type": "number" },
        "createdByUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdByName": { "type": "string", "maxLength": 100 },
        "createdByEmail": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "workspaceId",
        "type",
        "title",
        "description",
        "jalaliDate",
        "gregorianDate",
        "startTime",
        "endTime",
        "location",
        "meetingLink",
        "priority",
        "status",
        "assigneeEmail",
        "assigneeName",
        "assigneeUid",
        "agenda",
        "minutes",
        "checklist",
        "confirmedUids",
        "declinedUids",
        "notifyMembers",
        "reminderMinutes",
        "createdByUid",
        "createdByName",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceInvite": {
      "title": "WorkspaceInvite",
      "description": "Gmail-based team invitation linking a colleague's Gmail to a workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceName": { "type": "string", "maxLength": 100 },
        "invitedEmail": { "type": "string", "maxLength": 200 },
        "invitedByUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invitedByName": { "type": "string", "maxLength": 100 },
        "invitedByEmail": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["executive", "coordinator", "member"] },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "workspaceId",
        "workspaceName",
        "invitedEmail",
        "invitedByUid",
        "invitedByName",
        "invitedByEmail",
        "role",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile and Gmail identity."
    },
    "/users/{userId}/memberships/{workspaceId}": {
      "schema": { "$ref": "#/entities/UserMembership" },
      "description": "User's joined workspaces index."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "User's real-time notifications from teammates."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Shared team workspace document."
    },
    "/workspaces/{workspaceId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Authorized members of a workspace."
    },
    "/workspaces/{workspaceId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/WorkspaceItem" },
      "description": "Shared meetings, tasks, and events within a workspace."
    },
    "/workspaceInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/WorkspaceInvite" },
      "description": "Gmail invitations to join a workspace."
    }
  }
}
